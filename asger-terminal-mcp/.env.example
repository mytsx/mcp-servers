# SSH Terminal URL
TERMINAL_URL=https://your-terminal-url.com

# Optional: where the saved browser session is kept
# (default: session-state.json next to server.js)
# SESSION_FILE=/path/to/session-state.json

# Optional: where terminal screenshots are written
# (default: $TMPDIR/asger-terminal-mcp)
# SCREENSHOT_DIR=/path/to/screenshots

# Optional: Default wait times (milliseconds)
WAIT_AFTER_COMMAND=2000
WAIT_AFTER_CLEAR=1000
WAIT_AFTER_CLICK=500
